{
  "opencollection": "1.0.0",
  "info": {
    "name": "TrueLayer Payments Mandates Payouts API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Payouts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Payout",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.truelayer.com/v3/payouts",
            "headers": [
              {
                "name": "Tl-Signature",
                "value": ""
              },
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Initiate a payout from a merchant account to a user or external account. Used for refunds, withdrawals, and disbursements."
        },
        {
          "info": {
            "name": "Get Payout",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.truelayer.com/v3/payouts/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve the status of a payout."
        }
      ]
    }
  ],
  "bundled": true
}