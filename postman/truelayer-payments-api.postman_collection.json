                  "mode": "raw",
                  "raw": "{\n  \"amount_in_minor\": \"<integer>\",\n  \"currency\": \"GBP\",\n  \"payment_method\": {\n    \"type\": \"bank_transfer\",\n    \"beneficiary\": {\n      \"type\": \"merchant_account\",\n      \"merchant_account_id\": \"<uuid>\",\n      \"account_holder_name\": \"<string>\",\n      \"account_identifier\": {\n        \"type\": \"nrb\",\n        \"sort_code\": \"<string>\",\n        \"account_number\": \"<string>\",\n        \"iban\": \"<string>\"\n      }\n    },\n    \"provider_selection\": {\n      \"type\": \"user_selected\",\n      \"provider_id\": \"<string>\",\n      \"filter\": {}\n    },\n    \"scheme_selection\": {\n      \"type\": \"instant_preferred\"\n    }\n  },\n  \"user\": {\n    \"name\": \"<string>\",\n    \"id\": \"<string>\",\n    \"email\": \"<email>\",\n    \"phone\": \"<string>\",\n    \"date_of_birth\": \"<date>\",\n    \"address\": {}\n  },\n  \"metadata\": {\n    \"aliquip3_\": \"<string>\",\n    \"inb32\": \"<string>\",\n    \"ullamco_dd\": \"<string>\"\n  }\n}",
